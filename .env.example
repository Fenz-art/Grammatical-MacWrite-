NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Primary provider: OpenRouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash

# Transformation routing priority: Groq Qwen -> OpenRouter Ling -> DeepSeek -> OpenRouter GLM.
# Groq's model is set in GROQ_MODEL; omit model override for tiers that use the provider model.
LLM_ROUTING_ENABLED=true
LLM_DEFAULT_PROVIDER=groq
LLM_DEFAULT_MODEL=qwen/qwen3.8-27b
LLM_SECONDARY_PROVIDER=openrouter
LLM_SECONDARY_MODEL=inclusionai/ling-3.1-flash
LLM_TERTIARY_PROVIDER=deepseek
LLM_TERTIARY_MODEL=deepseek-reasoner
LLM_QUATERNARY_PROVIDER=openrouter
LLM_QUATERNARY_MODEL=z-ai/glm-5.3-flash

# Groq Qwen is the first tier; provider is enabled when both key and model are set.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Retained for non-LLM integrations that still use the Manus platform services.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OWNER_EMAIL=
# Optional live-provider corpus validation. Tests remain offline unless the
# explicit RUN_LIVE_PROVIDER_TESTS=true opt-in is provided at invocation.
RUN_LIVE_PROVIDER_TESTS=true
LIVE_PROVIDER_TEST_PROFILE=smoke
LIVE_PROVIDER_FILTER=
LIVE_PROVIDER_MAX_CASES_PER_MODE=2
LIVE_PROVIDER_MAX_TOTAL_CASES=0
LIVE_PROVIDER_MAX_COST_USD=0.50
LIVE_PROVIDER_TIMEOUT_MS=45000
LIVE_PROVIDER_MAX_OUTPUT_TOKENS=900
LIVE_PROVIDER_MAX_INPUT_TOKENS=8000
LIVE_PROVIDER_ESTIMATED_INPUT_USD_PER_MILLION=5
LIVE_PROVIDER_ESTIMATED_OUTPUT_USD_PER_MILLION=20
LIVE_PROVIDER_OUTPUT_DIR=artifacts/live-provider-tests

# Optional provider-specific target overrides. Ling and GLM otherwise use the
# configured OpenRouter route models (LLM_SECONDARY_MODEL/LLM_QUATERNARY_MODEL).
GROQ_QWEN_MODEL=
LING_API_URL=
LING_API_KEY=
LING_MODEL=
GLM_API_URL=
GLM_API_KEY=
GLM_MODEL=
